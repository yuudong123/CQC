MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=cqc_logistics
STORE_MODE=memory
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PUBLIC_WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000/api/v1
GOOGLE_MAPS_API_KEY=replace-with-browser-key

# QC operations: demo (browser state) or api (HTTP contract, no fallback).
# Set in apps/web/.env.local for local Next.js, or in the web container runtime.
CQC_QUALITY_MODE=demo
CQC_QUALITY_BACKEND_URL=
