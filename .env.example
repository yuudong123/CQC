MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=cqc
MYSQL_USER=cqc
MYSQL_PASSWORD=change_me

# Backend Inference client: use the real HTTP inference service in Compose.
INFERENCE_CLIENT_MODE=http
INFERENCE_URL=http://inference:8001/v1/predict
INFERENCE_MODEL_DIR=./models/cqc-apple-separate12-focal-v2-candidate
INFERENCE_PORT=8001
BACKEND_PORT=8000
# DM-08 보정 모델 기준 신뢰도 임계값 (보정 전 model.json이면 품질 0.50 유지)
CULTIVAR_CONFIDENCE_THRESHOLD=0.50
QUALITY_CONFIDENCE_THRESHOLD=0.60

# CQC Logistics (GPU 미사용, 공통 Compose/Jenkins 배포)
LOGISTICS_MONGODB_DATABASE=cqc_logistics
LOGISTICS_WEB_PORT=3100
LOGISTICS_API_PORT=8100
LOGISTICS_PUBLIC_WEB_ORIGIN=http://192.168.133.106:3100
LOGISTICS_PUBLIC_API_URL=http://192.168.133.106:8100/api/v1
GOOGLE_MAPS_API_KEY=
