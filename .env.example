MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=cqc
MYSQL_USER=cqc
MYSQL_PASSWORD=change_me

# Backend MySQL connection attempt timeout in seconds.
DB_CONNECT_TIMEOUT_SECONDS=1
# QC inspection rows: delete the oldest batch when the row limit is reached.
INSPECTION_HISTORY_LIMIT=86400
INSPECTION_HISTORY_DELETE_BATCH=8640

# Bounded process-memory diagnostics; independent of DB retention and active tasks.
VIRTUAL_CONTROL_HISTORY_LIMIT=200
LATE_RESULT_HISTORY_LIMIT=200

# Backend Inference client: use the real HTTP inference service in Compose.
INFERENCE_CLIENT_MODE=http
INFERENCE_URL=http://inference:8001/v1/predict
# TCP connection only; the inference business deadline remains 500ms.
INFERENCE_CONNECT_TIMEOUT_MS=200
# 서비스에 쓰는 선정 모델 폴더. 모든 버전은 models/model_<버전·특징>/에 두고 선정한 것을 selected에 복사한다
INFERENCE_MODEL_DIR=./models/selected
INFERENCE_PORT=8001
BACKEND_PORT=8000
# DM-08 보정 모델 기준 신뢰도 임계값 (보정 전 model.json이면 품질 0.50 유지)
CULTIVAR_CONFIDENCE_THRESHOLD=0.50
QUALITY_CONFIDENCE_THRESHOLD=0.60

# Transient image previews: 60s maximum age and 3s read grace after completion.
LIVE_PREVIEW_LIMIT=64
LIVE_PREVIEW_MAX_AGE_SECONDS=60
LIVE_PREVIEW_GRACE_SECONDS=3
LIVE_PREVIEW_MAX_DIMENSION=240
LIVE_PREVIEW_JPEG_QUALITY=90

# Backend → Simulator internal API.
# SIMULATOR_INTERNAL_URL=http://simulator:8002
# SIMULATOR_INTERNAL_TIMEOUT_MS=30000
# SIMULATOR_STATE_TIMEOUT_MS=1500

# Backend와 Simulator가 동일하게 사용하는 내부 인증 토큰
# 로컬 실행용 예제 값. 실제 배포 시 별도 토큰으로 교체합니다.
SIMULATOR_FAULT_TOKEN=change_me_simulator_token

# Separate Simulator process. Dataset path is read-only; position path is writable.
# SIMULATOR_DATASET_ROOT=<read-only dataset mount containing index.json>
# For compose.local.yaml only; the main Compose stack uses an external Docker volume.
# SIMULATOR_DATASET_HOST_PATH=./data/processed/realtime-apple-arrival-demo
# SIMULATOR_BRIX_CSV_PATH=<optional CSV path; defaults to dataset root/demo-virtual-brix.csv>
# SIMULATOR_POSITION_PATH=<writable persistent mount>/position.json
# SIMULATOR_BACKEND_URL=http://backend:8000
# 입력 간격 (DM-08 서버컴 기준 2000ms). 처리 주기보다 짧으면 요청이 밀린다
SIMULATOR_INTERVAL_MS=2000
# SIMULATOR_BIND_HOST=0.0.0.0
# SIMULATOR_BIND_PORT=8002
# SIMULATOR_MAX_REQUEST_BYTES=25165824

# CQC Logistics (GPU 미사용, 공통 Compose/Jenkins 배포)
LOGISTICS_MONGODB_DATABASE=cqc_logistics
LOGISTICS_WEB_PORT=3100
LOGISTICS_API_PORT=8100
LOGISTICS_PUBLIC_WEB_ORIGIN=http://192.168.133.106:3100
LOGISTICS_PUBLIC_API_URL=http://192.168.133.106:8100/api/v1
GOOGLE_MAPS_API_KEY=
